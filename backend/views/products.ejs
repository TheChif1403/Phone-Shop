<div class="container mt-4">
    <h1 class="mb-4">Quản lý sản phẩm</h1>

    <!-- Form thêm sản phẩm -->
    <form id="addProductForm" class="row g-3">
        <div class="col-md-6"><input type="text" name="name" class="form-control" placeholder="Tên sản phẩm" required></div>
        <div class="col-md-6"><input type="number" name="price" class="form-control" placeholder="Giá" required></div>
        <div class="col-md-4"><input type="text" name="brand" class="form-control" placeholder="Thương hiệu"></div>
        <div class="col-md-4"><input type="text" name="category" class="form-control" placeholder="Danh mục"></div>
        <div class="col-md-4"><input type="number" name="stock" class="form-control" placeholder="Tồn kho" required></div>
        <div class="col-12"><textarea name="description" class="form-control" placeholder="Mô tả sản phẩm"></textarea></div>
        <div class="col-12"><input type="text" name="image" class="form-control" placeholder="URL hình ảnh"></div>
        <div class="col-12"><button type="submit" class="btn btn-success">Thêm sản phẩm</button></div>
    </form>

    <!-- Danh sách sản phẩm -->
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Giá</th>
                <th>Thương hiệu</th>
                <th>Danh mục</th>
                <th>Hành động</th>
                <th>Tồn kho</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(p => { %>
                <tr data-id="<%= p._id %>">
                    <td>
                        <%= p.name %>
                    </td>
                    <td>
                        <%= p.price %>
                    </td>
                    <td>
                        <%= p.brand %>
                    </td>
                    <td>
                        <%= p.category %>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-primary editBtn">Sửa</button>
                        <button class="btn btn-sm btn-danger deleteBtn">Xóa</button>
                    </td>
                    <td>
                        <%= p.stock %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>

    <!-- Lịch sử nhập kho -->
    <h3 class="mt-4">Lịch sử nhập kho</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Sản phẩm</th>
                <th>Thay đổi</th>
                <th>Lý do</th>
                <th>Ngày</th>
            </tr>
        </thead>
        <tbody>
            <% stockHistory.forEach(h => { %>
                <tr>
                    <td>
                        <%= h.productId.name %>
                    </td>
                    <td>
                        <%= h.change %>
                    </td>
                    <td>
                        <%= h.reason %>
                    </td>
                    <td>
                        <%= h.createdAt.toLocaleString() %>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table>
</div>

<script src="/js/adminProducts.js"></script>